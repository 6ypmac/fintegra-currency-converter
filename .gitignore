# ===== Angular app (in /app) =====

# Compiled output
app/dist/
app/tmp/
app/out-tsc/
app/bazel-out/

# Angular cache / build artifacts
app/.angular/
app/.angular/cache/
app/.ng/

# Tests / coverage
app/coverage/
app/__screenshots__/

# Node
app/node_modules/
app/npm-debug.log*
app/yarn-error.log*
app/yarn-debug.log*
app/testem.log
app/.sass-cache/
app/libpeerconnection.log
app/connect.lock
app/typings/

# Env files / local configs
app/.env
app/.env.*
app/.env.*.local

# ===== IDEs and editors =====
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code (keep team-shared settings if you want)
app/.vscode/*
!app/.vscode/settings.json
!app/.vscode/tasks.json
!app/.vscode/launch.json
!app/.vscode/extensions.json
app/.history/*

# ===== System files =====
.DS_Store
Thumbs.db